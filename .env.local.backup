# Local Development Environment Variables
SPRING_PROFILES_ACTIVE=local

# Local PostgreSQL Database
DB_URL=jdbc:postgresql://postgres:5432/muti_local
DB_USERNAME=muti
DB_PASSWORD=muti_local_password

# JWT Secret (local development only)
JWT_SECRET=local-development-secret-key-for-testing-only-change-in-production

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_MUTI=DEBUG