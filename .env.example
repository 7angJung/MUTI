# MUTI Application Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration (Supabase PostgreSQL - Transaction Pooler)
# NOTE: Use Transaction Pooler (port 6543) for better connection pooling
# Transaction Pooler supports more concurrent connections than Session Pooler
# prepareThreshold=0: pgBouncer does not support prepared statements, must disable
DB_URL=jdbc:postgresql://aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?prepareThreshold=0
DB_USERNAME=postgres.qlnuleskbxqhpyadsoeo
DB_PASSWORD=your-supabase-password-here

# Application Profile
SPRING_PROFILES_ACTIVE=prod

# JWT Configuration
# Generate a secure random string (minimum 256 bits / 32 characters)
# You can use: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-at-least-256-bits-long-change-this